{
  "name": "@kurdish-dev-toolkit/core",
  "version": "0.1.0-alpha.0",
  "description": "Kurdish Sorani text, RTL, number, date, currency and i18n utilities for JavaScript and TypeScript.",
  "license": "MIT",
  "author": "Kurdish Developer Toolkit contributors",
  "homepage": "https://github.com/renas94/kurdish-dev-toolkit/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renas94/kurdish-dev-toolkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/renas94/kurdish-dev-toolkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./rtl": {
      "types": "./dist/rtl/index.d.ts",
      "default": "./dist/rtl/index.js"
    },
    "./numbers": {
      "types": "./dist/numbers/index.d.ts",
      "default": "./dist/numbers/index.js"
    },
    "./dates": {
      "types": "./dist/dates/index.d.ts",
      "default": "./dist/dates/index.js"
    },
    "./currency": {
      "types": "./dist/currency/index.d.ts",
      "default": "./dist/currency/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "kurdish",
    "sorani",
    "ckb",
    "rtl",
    "bidi",
    "i18n",
    "localization",
    "unicode",
    "numerals",
    "iqd"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "docs": "typedoc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
